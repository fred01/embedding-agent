{
  "name": "Embedding Agent",
  "image": "ghcr.io/fred01/embedding-agent-devcontainer:latest",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black"
      }
    }
  },


  "containerEnv": {
    "INDEXER_URL": "${localEnv:INDEXER_URL:https://book-indexer.svc.fred.org.ru}",
    "AGENT_TOKEN": "${localEnv:AGENT_TOKEN}",
    "RS_HTTP_FACADE_TOKEN": "${localEnv:RS_HTTP_FACADE_TOKEN}",
    "WORKER_NAME": "${localEnv:WORKER_NAME}",
    "DEVICE": "cpu",
    "PYTHONUNBUFFERED": "1"
  },

  "workspaceFolder": "/workspaces/work/embedding-agent",

  "remoteUser": "root"
}
